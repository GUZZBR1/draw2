modules = ["python-3.12", "nodejs-20", "bash", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Draw website"

[[workflows.workflow]]
name = "Draw website"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm --prefix site run dev -- --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = "cd site && npm ci && npm run build"
publicDir = "site/dist"

[[deployment.rewrites]]
from = "/*"
to = "/index.html"
